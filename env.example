# Shopify webhook signing secret (from Shopify Partner dashboard > Your app > API credentials)
SHOPIFY_API_SECRET=

# Vapi credentials (from vapi.ai dashboard)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# How many minutes of inactivity before calling (default 2)
ABANDON_DELAY_MINUTES=2

# --- SAFETY ---
# MODE=test (default): only calls phones in ALLOWED_PHONES. Real customers are skipped.
# MODE=live: calls every abandoned checkout. Only flip to live after testing.
MODE=test

# Comma-separated phone numbers allowed to be called in test mode.
# Use E.164 format with country code, e.g. +15551234567,+15559876543
ALLOWED_PHONES=

# Random secret to protect the stats page. Page becomes /stats/<this>
# If empty, page is at /stats and publicly accessible.
STATS_SECRET=

# Server port (Render/Fly/Railway set this automatically)
PORT=3000
